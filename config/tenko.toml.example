# Tenko 配置示例。
# 复制为 config/tenko.toml 后按 NapCat 实际地址修改；不要把真实 token 提交到仓库。

# 通知群：邀请审批等管理通知的播报目标；留空表示私发 Master。该键必须位于 TOML 顶层。
notify_group = ""

# 旧版 [runtime] / [entari] 中的通用字段统一放在 Entari 官方 [basic] 节。
# Tenko 默认保留 / 作为命令前缀；也可以配置多个前缀，例如 ["/", "!"]。
[basic]
prefix = ["/"]
ignore_self_message = true
skip_req_missing = false
nickname = ""
cmd_count = 4096
external_dirs = []
schema = false
check_metadata = false
str_as_message = true
# 超管唯一权威来源：键为平台名称，值为该平台的用户 ID 字符串列表。
superusers = { onebot = ["YOUR_QQ_ID"] }

[basic.log]
level = "INFO"
ignores = []
# 启用官方日志轮转并落盘到 Entari 的日志目录；默认不落盘（save=None）。
# save 启用后，日志目录由 Entari localdata 决定：cwd/(base_dir 或 ".entari")/log。
# 警告：不要随意修改 localdata 的 base_dir；migrations_lock.json（数据库迁移状态）
# 位于 data 目录下，换目录会让迁移器误判为全新库，对已有数据重复 autogenerate。
# 本项目数据目录是 .tenko（Tenko 自有数据），Entari 框架数据目录是 .entari，两者并存。
# save = { rotation = "00:00", compression = "gz", colorize = false }
rich_error = false
short_level = false

# basic.network 仅按 Entari 官方格式解析并保留，Tenko 的 OneBot 连接仍由下方
# [onebot] 配置驱动；不要把 NapCat 反向 WebSocket 地址填到这里。
# [[basic.network]]
# type = "ws"
# host = "127.0.0.1"
# port = 5140
# path = "satori"
# secure = false
# token = ""
# timeout = 10.0

[onebot]
# Tenko 监听 NapCat 反向 WebSocket 的地址。
listen_host = "127.0.0.1"
listen_port = 8080
reverse_ws_prefix = "/"
reverse_ws_path = "onebot/v11"
reverse_ws_endpoint = "ws"

# NapCat 配置了 token 时，在这里填写相同 token；本地无鉴权时可留空字符串。
access_token = "replace-with-napcat-token"
api_timeout = 60

# 这是 Tenko 内部的 Satori WebSocket，不是 NapCat 的连接地址。
satori_host = "127.0.0.1"
satori_path = "satori"
satori_token = "tenko-satori-local"

# 可选：按账号覆盖 action service 的能力学习结果。键为逻辑能力名；未配置的能力
# 仍采用“首次调用成功/失败”探测。NapCat 扩展的真实失败语义待第⑧步实测确认。
# [onebot.capability_overrides."10001"]
# member_mute = true
# group_mute = true
# group_essence = false

[webui]
# 默认关闭；开启后复用上面的 OneBot/Satori 监听端口，不会新开端口。
enabled = false
# 必须配置独立于 [onebot] 的 token；不要复用 OneBot token，也不要暴露到公网。
token = ""
# 可选的独立管理令牌，必须与只读 token 不同；未配置时不开放任何管理操作。
# admin_token = "替换为独立随机管理令牌"
# 仅允许这些来源 IP 访问 WebUI；如无必要请保持本机白名单。
allowed_ips = ["127.0.0.1"]

[database]
# 与旧 Graia 数据库同构，默认直接使用 Tenko 数据目录中的 SQLite 文件。
url = "sqlite+aiosqlite:///./.tenko/tenko.db"
# 每次安装升级前，文件型 SQLite 会自动生成 tenko.db.bak-<version>-<timestamp>；最近保留 3 份。
# 升级相关 schema 变更只允许向前兼容：废弃列先标记 deprecated，跨两个版本后再清理。
echo = false
create_table_at = "preparing"

[debug]
# 开启后，Tenko 只处理 masters 中 QQ 号对应用户产生的事件。
enabled = false
# ID 建议写成字符串；省略时继承 [basic].superusers，显式填写（包括 []）会覆盖继承。
# masters = ["10001"]

[features]
# 群×插件功能开关和全局维护状态保存在 database.url 指定的数据库中。
default_enabled = true

[ratelimit]
# 命令按用户×群执行滚动窗口限流；群管理员达到 override_permission 时豁免。
enabled = true
# 频控窗口、冷却和黑名单状态保存在 database.url 指定的数据库中。
window_seconds = 15.0
max_weight = 24
default_weight = 1
cooldown_seconds = 5.0
blacklist_seconds = 300.0
override_permission = 32

[render]
# 图片渲染由内置 RenderService 提供（Playwright + Chromium，必装，无开关）。
# 需要先执行 `python -m playwright install chromium`；浏览器不可用时状态和
# 异常报告自动回退文本。
timeout = 10.0
width = 800
quality = 85
device_scale_factor = 2

[exception]
# 异常报告最近消息环形缓冲条数；超出后按先进先出淘汰。
message_buffer_size = 10
# 向 superusers 发送失败时的本地取证目录。
evidence_dir = ".tenko/exceptions"

[upgrade]
# 宿主升级默认只检查，不自动下载或安装。不要把旧 config/config_demo.yaml 的
# auto_upgrade=true 直接迁移过来；新系统不会执行 git pull 式原地更新。
enabled = true
# 可选：git_tag、github_release 或 manifest。
source = "git_tag"
# git_tag 源填写 git remote 名（如 origin）或 URL；"." 只查本地 refs。
repository = "origin"
github_repository = ""
manifest_url = ""
github_token = ""
asset_name = ""
tag_prefix = "v"
# stable 只认正式版本；prerelease 额外包含 pre 版本。
channel = "stable"
# check = 只检查并记录；download = 自动准备制品；install = 自动生成外部安装接管记录。
policy = "check"
# 留空时从项目 pyproject.toml 的 [project].version 读取。
current_version = ""
# 用户配置的兼容版本；制品可在 upgrade-manifest.json 中声明 min_config_version。
config_version = "1.0.0"
install_root = ".tenko/upgrades"
config_path = "config/tenko.toml"
# 仅传给自定义健康检查/启动命令的外部目录；Tenko 自身数据仍使用 .tenko。
data_dir = "data"
# 可选健康检查命令。{python}、{release_root}、{config_path}、{data_dir} 可作为独立参数使用。
health_command = []
# 可选外部启动命令。{python}、{release_root}、{config_path}、{data_dir} 可替换。
launch_command = []
health_timeout = 30
# 旧进程退出 watcher 的最长等待时间；超时会留痕但不会强制拉起。
restart_watch_timeout = 300
# 默认 24 小时；保留旧版周期检查场景，但策略默认不下载/安装。
check_interval_hours = 24
# 仅这些用户能执行 /检查更新、/升级、/回滚；省略时继承 [basic].superusers。
# 显式填写（包括 []）会覆盖继承；ID 可写字符串或整数。
# superuser_ids = ["YOUR_QQ_ID"]
